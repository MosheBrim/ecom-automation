# Server
PORT=3001
NODE_ENV=development

# Amazon Credentials
AMAZON_EMAIL=your-test-email@example.com
AMAZON_PASSWORD=your-test-password

# Automation
HEADLESS=false
SLOW_MO=0
DEFAULT_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Screenshots
SCREENSHOTS_DIR=screenshots

# CORS
FRONTEND_URL=http://localhost:5173
