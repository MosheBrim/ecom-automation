# Server
PORT=3001
NODE_ENV=development

# Site Credentials (practicesoftwaretesting.com)
SITE_EMAIL=customer@practicesoftwaretesting.com
SITE_PASSWORD=welcome01
SITE_URL=https://practicesoftwaretesting.com

# Automation
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000

# Default Shipping Address (used automatically during checkout)
SHIPPING_STREET=123 Test Street
SHIPPING_CITY=New York
SHIPPING_STATE=NY
SHIPPING_COUNTRY=US
SHIPPING_POSTAL_CODE=10001

# Default Payment Method (bank-transfer / credit-card / cash-on-delivery)
PAYMENT_METHOD=bank-transfer

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Screenshots
SCREENSHOTS_DIR=screenshots

# CORS
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_AUTO_BUY_DELAY_MS=1500
